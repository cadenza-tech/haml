{
  "doctype": {
    "prefix": "doctype",
    "body": ["!!! ${1|5,XML,Strict,Frameset,1.1,Basic,Mobile,RDFa|}"],
    "description": "Haml doctype declaration"
  },
  "silent comment": {
    "prefix": "comment",
    "body": ["-# $1"],
    "description": "Haml silent comment (not rendered)"
  },
  "html comment": {
    "prefix": "htmlcomment",
    "body": ["/ $1"],
    "description": "Haml HTML comment (rendered)"
  },
  "conditional comment": {
    "prefix": "ifcomment",
    "body": ["/[if ${1:IE}]", "  $2"],
    "description": "Haml conditional HTML comment"
  },
  "haml-lint disable": {
    "prefix": "hamllintdisable",
    "body": ["-# haml-lint:disable ${1:LinterName}", "$2", "-# haml-lint:enable ${1:LinterName}"],
    "description": "Disable a haml-lint linter for a block"
  },
  "filter: ruby": {
    "prefix": "ruby",
    "body": [":ruby", "  $1"],
    "description": "Haml :ruby filter"
  },
  "filter: javascript": {
    "prefix": "javascript",
    "body": [":javascript", "  $1"],
    "description": "Haml :javascript filter"
  },
  "filter: css": {
    "prefix": "css",
    "body": [":css", "  $1"],
    "description": "Haml :css filter"
  },
  "filter: sass": {
    "prefix": "sass",
    "body": [":sass", "  $1"],
    "description": "Haml :sass filter"
  },
  "filter: scss": {
    "prefix": "scss",
    "body": [":scss", "  $1"],
    "description": "Haml :scss filter"
  },
  "filter: markdown": {
    "prefix": "markdown",
    "body": [":markdown", "  $1"],
    "description": "Haml :markdown filter"
  },
  "filter: plain": {
    "prefix": "plain",
    "body": [":plain", "  $1"],
    "description": "Haml :plain filter"
  },
  "filter: preserve": {
    "prefix": "preserve",
    "body": [":preserve", "  $1"],
    "description": "Haml :preserve filter"
  },
  "filter: escaped": {
    "prefix": "escaped",
    "body": [":escaped", "  $1"],
    "description": "Haml :escaped filter"
  },
  "filter: cdata": {
    "prefix": "cdata",
    "body": [":cdata", "  $1"],
    "description": "Haml :cdata filter"
  }
}
