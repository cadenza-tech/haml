{
  "comments": {
    "lineComment": "-#"
  },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["comment"] },
    { "open": "'", "close": "'", "notIn": ["comment"] },
    { "open": "#{", "close": "}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "onEnterRules": [
    {
      "beforeText": "^\\s*[-=~]\\s*(if|unless|else|elsif|when|in|case|while|until|for|begin|rescue|ensure)\\b.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*[-=~].*\\bdo\\b(\\s*\\|[^|]*\\|)?\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(?!%(?:area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)(?![\\w:-]))[%.#][\\w.#:-]*([{(\\[].*[})\\]])?[<>]*\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*:[\\w-]+\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
