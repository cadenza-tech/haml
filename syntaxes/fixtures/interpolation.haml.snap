#               ^^ text.haml js.haml meta.embedded.line.ruby.haml punctuation.section.embedded.begin.haml
#                 ^^^^^^^^^^^^^^^^^^^ text.haml js.haml meta.embedded.line.ruby.haml source.ruby
#                                    ^ text.haml js.haml meta.embedded.line.ruby.haml punctuation.section.embedded.end.haml
#                                     ^^ text.haml js.haml
>  var double = #{helper.fetch("key")};
#^^^^^^^^^^^^^^^ text.haml js.haml
#               ^^ text.haml js.haml meta.embedded.line.ruby.haml punctuation.section.embedded.begin.haml
#                 ^^^^^^^^^^^^^^^^^^^ text.haml js.haml meta.embedded.line.ruby.haml source.ruby
