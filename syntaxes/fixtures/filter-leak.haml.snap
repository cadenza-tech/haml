>  const b = LEFT_OPEN_BY_THE_STUB
#^^^^^^^^^^^^ text.haml js.inline.haml
#            ^^^^^^^^^^^^^^^^^^^^^ text.haml js.inline.haml meta.left-open.stub
>%p after script
